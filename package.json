{
  "name": "bookmark-syncer",
  "productName": "Bookmark syncer",
  "version": "1.2.0",
  "description": "Import bookmarks from all your browsers into one organized library.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "test": "node scripts/test-db.js && node scripts/test-sync.js && node scripts/test-extension.js && node scripts/test-ollama.js && node scripts/test-dups.js && node scripts/test-autoimport.js && node scripts/test-later.js && node scripts/test-safety.js && node scripts/test-library-file.js && node scripts/test-browsers.js && node scripts/check-i18n.js",
    "dist": "electron-builder --win nsis",
    "dist:store": "node scripts/dist-store.js",
    "check-i18n": "node scripts/test-browsers.js && node scripts/check-i18n.js"
  },
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "author": "b0red",
  "build": {
    "appId": "io.github.b0red.bookmarksyncer",
    "productName": "Bookmark syncer",
    "copyright": "GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "extension/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "extension/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bookmark syncer",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE",
      "artifactName": "Bookmark-syncer-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "en-US",
      "sv"
    ],
    "appx": {
      "identityName": "B0red.bookmarker",
      "publisher": "CN=81BE1A85-1B75-436E-A087-44BDC60675D7",
      "publisherDisplayName": "B0red",
      "applicationId": "BookmarkSyncer",
      "displayName": "bookmarker",
      "backgroundColor": "transparent",
      "languages": [
        "en-US",
        "sv-SE"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.19045.0",
      "customManifestPath": "appxmanifest.xml",
      "artifactName": "Bookmark-syncer-${version}-Store.${ext}"
    }
  }
}
